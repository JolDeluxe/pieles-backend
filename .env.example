# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
NODE_ENV=development

# Ruta al ejecutable de Bun para PM2 (Opcional si bun está en el PATH global del servidor)
# Ejemplo Windows: BUN_PATH="C:\Users\Administrador\.bun\bin\bun.exe"
# Ejemplo Linux:   BUN_PATH="/root/.bun/bin/bun" o BUN_PATH="bun"
BUN_PATH=bun

# Seguridad & Proxy
# Activar 'true' si corre detrás de Nginx, Traefik, AWS ALB, Cloudflare, etc.
TRUST_PROXY=false

# CORS (Orígenes separados por coma). En producción incluir la URL de Netlify:
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://avances-mbc.netlify.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==========================================
# USUARIO SUPER ADMINISTRADOR INICIAL (SEED)
# ==========================================
SUPER_ADMIN_USUARIO=admin
SUPER_ADMIN_PASSWORD=Deadmau6

# ==========================================
# BASE DE DATOS (MySQL)
# ==========================================
DATABASE_URL="mysql://usuario:password@localhost:3306/materia_prima_db"
